classDiagram
    %% Core Application Layer
    class App {
        <<React Application>>
        +render() ReactElement
        +handleRouting() void
        +manageGlobalState() void
    }

    %% API Gateway
    class APIGateway {
        +authenticate(token: string) boolean
        +rateLimit(userId: string) boolean
        +routeRequest(path: string) Response
        +logRequest(request: Request) void
    }

    %% Frontend Components
    class MenuComponent {
        +displayMenu(categories: MenuCategory[]) ReactElement
        +filterItems(filters: Filter[]) MenuItem[]
        +searchItems(query: string) MenuItem[]
        +handleItemSelection(item: MenuItem) void
    }

    class OrderComponent {
        +displayCart(items: OrderItem[]) ReactElement
        +updateQuantity(itemId: string, quantity: number) void
        +removeItem(itemId: string) void
        +calculateTotal() number
        +proceedToCheckout() void
    }

    class PaymentComponent {
        +processPayment(paymentData: PaymentInfo) Promise~PaymentResult~
        +validatePaymentMethod(method: PaymentMethod) boolean
        +handlePaymentSuccess(result: PaymentResult) void
        +handlePaymentFailure(error: PaymentError) void
    }

    %% Backend Services
    class MenuService {
        -menuRepository: MenuRepository
        +getMenuByRestaurant(restaurantId: string) Promise~Menu~
        +getMenuItems(categoryId: string) Promise~MenuItem[]~
        +searchMenuItems(query: string, filters: Filter[]) Promise~MenuItem[]~
        +updateMenuAvailability(itemId: string, available: boolean) Promise~void~
    }

    class OrderService {
        -orderRepository: OrderRepository
        -pricingService: PricingService
        -inventoryService: InventoryService
        +createOrder(orderData: CreateOrderRequest) Promise~Order~
        +updateOrder(orderId: string, updates: OrderUpdate) Promise~Order~
        +getOrderStatus(orderId: string) Promise~OrderStatus~
        +cancelOrder(orderId: string) Promise~void~
        +validateOrder(order: Order) Promise~ValidationResult~
    }

    class PricingService {
        -pricingRepository: PricingRepository
        +calculateItemPrice(item: MenuItem, customizations: Customization[]) Promise~number~
        +calculateOrderTotal(order: Order) Promise~PriceBreakdown~
        +applyDiscounts(order: Order, discounts: Discount[]) Promise~number~
        +validatePricing(order: Order) Promise~boolean~
    }

    class InventoryService {
        -inventoryRepository: InventoryRepository
        -eventPublisher: EventPublisher
        +checkAvailability(itemId: string, quantity: number) Promise~boolean~
        +reserveItems(items: OrderItem[]) Promise~ReservationResult~
        +updateStock(itemId: string, quantity: number) Promise~void~
        +getStockLevel(itemId: string) Promise~number~
        +releaseReservation(reservationId: string) Promise~void~
    }

    class PaymentService {
        -stripeClient: StripeClient
        -paymentRepository: PaymentRepository
        +processPayment(paymentInfo: PaymentInfo) Promise~PaymentResult~
        +refundPayment(paymentId: string, amount: number) Promise~RefundResult~
        +validatePaymentMethod(method: PaymentMethod) Promise~boolean~
        +getPaymentStatus(paymentId: string) Promise~PaymentStatus~
    }

    class NotificationService {
        -emailService: EmailService
        -smsService: SMSService
        -pushService: PushNotificationService
        +sendOrderConfirmation(order: Order) Promise~void~
        +sendStatusUpdate(orderId: string, status: OrderStatus) Promise~void~
        +sendPaymentNotification(paymentResult: PaymentResult) Promise~void~
    }

    %% Data Models
    class Restaurant {
        +id: string
        +name: string
        +address: Address
        +phone: string
        +email: string
        +operatingHours: OperatingHours
        +settings: RestaurantSettings
        +createdAt: Date
        +updatedAt: Date
    }

    class Menu {
        +id: string
        +restaurantId: string
        +name: string
        +description: string
        +categories: MenuCategory[]
        +isActive: boolean
        +validFrom: Date
        +validTo: Date
        +createdAt: Date
        +updatedAt: Date
    }

    class MenuCategory {
        +id: string
        +menuId: string
        +name: string
        +description: string
        +displayOrder: number
        +items: MenuItem[]
        +isActive: boolean
    }

    class MenuItem {
        +id: string
        +categoryId: string
        +name: string
        +description: string
        +basePrice: number
        +images: string[]
        +customizations: CustomizationGroup[]
        +dietaryInfo: DietaryInfo
        +nutritionInfo: NutritionInfo
        +isAvailable: boolean
        +preparationTime: number
        +tags: string[]
    }

    class CustomizationGroup {
        +id: string
        +name: string
        +description: string
        +isRequired: boolean
        +minSelections: number
        +maxSelections: number
        +options: CustomizationOption[]
    }

    class CustomizationOption {
        +id: string
        +name: string
        +description: string
        +priceAdjustment: number
        +isDefault: boolean
        +isAvailable: boolean
    }

    class Order {
        +id: string
        +restaurantId: string
        +customerId: string
        +items: OrderItem[]
        +subtotal: number
        +tax: number
        +total: number
        +status: OrderStatus
        +orderType: OrderType
        +tableNumber: string
        +specialInstructions: string
        +createdAt: Date
        +updatedAt: Date
        +estimatedCompletionTime: Date
    }

    class OrderItem {
        +id: string
        +menuItemId: string
        +quantity: number
        +unitPrice: number
        +totalPrice: number
        +customizations: AppliedCustomization[]
        +specialInstructions: string
    }

    class AppliedCustomization {
        +customizationId: string
        +optionId: string
        +name: string
        +priceAdjustment: number
    }

    class Customer {
        +id: string
        +name: string
        +email: string
        +phone: string
        +preferences: CustomerPreferences
        +loyaltyPoints: number
        +orders: Order[]
        +createdAt: Date
    }

    class Payment {
        +id: string
        +orderId: string
        +amount: number
        +method: PaymentMethod
        +status: PaymentStatus
        +transactionId: string
        +processedAt: Date
        +refunds: Refund[]
    }

    %% Repositories
    class MenuRepository {
        +findByRestaurantId(restaurantId: string) Promise~Menu~
        +findMenuItems(filters: MenuFilter) Promise~MenuItem[]~
        +updateAvailability(itemId: string, available: boolean) Promise~void~
        +create(menu: Menu) Promise~Menu~
        +update(id: string, updates: Partial~Menu~) Promise~Menu~
    }

    class OrderRepository {
        +create(order: Order) Promise~Order~
        +findById(id: string) Promise~Order~
        +update(id: string, updates: Partial~Order~) Promise~Order~
        +findByCustomerId(customerId: string) Promise~Order[]~
        +findByStatus(status: OrderStatus) Promise~Order[]~
    }

    class InventoryRepository {
        +findByItemId(itemId: string) Promise~InventoryItem~
        +updateStock(itemId: string, quantity: number) Promise~void~
        +bulkUpdateStock(updates: StockUpdate[]) Promise~void~
        +findLowStockItems(threshold: number) Promise~InventoryItem[]~
    }

    %% Utilities and Helpers
    class ValidationService {
        +validateOrder(order: Order) ValidationResult
        +validateCustomizations(item: MenuItem, customizations: Customization[]) ValidationResult
        +validatePaymentInfo(paymentInfo: PaymentInfo) ValidationResult
        +validateInventoryAvailability(items: OrderItem[]) Promise~ValidationResult~
    }

    class CacheService {
        +get(key: string) Promise~any~
        +set(key: string, value: any, ttl: number) Promise~void~
        +delete(key: string) Promise~void~
        +invalidatePattern(pattern: string) Promise~void~
    }

    class EventPublisher {
        +publish(event: DomainEvent) Promise~void~
        +subscribe(eventType: string, handler: EventHandler) void
    }

    %% Relationships
    App --> MenuComponent
    App --> OrderComponent
    App --> PaymentComponent
    
    MenuComponent --> MenuService
    OrderComponent --> OrderService
    PaymentComponent --> PaymentService
    
    APIGateway --> MenuService
    APIGateway --> OrderService
    APIGateway --> PaymentService
    APIGateway --> NotificationService
    
    OrderService --> PricingService
    OrderService --> InventoryService
    OrderService --> ValidationService
    OrderService --> OrderRepository
    
    MenuService --> MenuRepository
    MenuService --> CacheService
    
    PricingService --> ValidationService
    
    InventoryService --> InventoryRepository
    InventoryService --> EventPublisher
    
    PaymentService --> NotificationService
    
    Restaurant ||--o{ Menu
    Menu ||--o{ MenuCategory
    MenuCategory ||--o{ MenuItem
    MenuItem ||--o{ CustomizationGroup
    CustomizationGroup ||--o{ CustomizationOption
    
    Customer ||--o{ Order
    Order ||--o{ OrderItem
    OrderItem ||--o{ AppliedCustomization
    Order ||--|| Payment
    
    MenuService --> Restaurant
    MenuService --> Menu
    OrderService --> Order
    PaymentService --> Payment